# dependencies
node_modules/

# builds
.next/
out/
dist/
build/

# Next's generated ambient types. Regenerated by `next typegen` (which every app's `typecheck` and
# `build` run first) and by `next dev` — and the two disagree: dev writes a reference to
# `.next/dev/types/routes.d.ts`, build writes `.next/types/routes.d.ts`. Tracking it therefore made
# `pnpm verify` dirty the working tree and flip the file back and forth depending on what ran last.
# Each app's tsconfig still lists it in `include`; it exists by the time tsc runs.
next-env.d.ts

# local data written by fake adapters (pglite, storage, caught emails)
.data/

# test output
coverage/
playwright-report/
test-results/

# env & secrets — secret values never live in the repo
.env
.env.*
!.env.example

# tooling caches
*.tsbuildinfo
.eslintcache
.turbo/
.ladle/dist/

# machine-local Claude Code settings (CLAUDE.md and .claude/commands ARE committed)
.claude/settings.local.json

# OS
.DS_Store

# static demo build output
dist-demo/

# cdk synth output
infra/cdk.out/

# generated per checkout by scripts/write-launch-json.mjs (ports differ per worktree)
.claude/launch.json
