{
    "name": "starter",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "The starter app: the minimum an adopter keeps — one entity, one card, and an otherwise empty seam (ADR-0007, ADR-0012).",
    "scripts": {
        "dev": "NEXT_TELEMETRY_DISABLED=1 APP_MODE=simulated next dev --port \"$(node ../../scripts/print-port.mjs starter)\"",
        "build": "NEXT_TELEMETRY_DISABLED=1 next build",
        "start": "next start --port \"$(node ../../scripts/print-port.mjs starter)\"",
        "typecheck": "next typegen && tsc --noEmit",
        "test:e2e": "NEXT_TELEMETRY_DISABLED=1 playwright test",
        "build:demo-static": "vite build --config vite.demo.config.ts",
        "check:demo-size": "node ../../scripts/check-demo-size.mjs 880000",
        "e2e:demo-static": "playwright test --config playwright.demo.config.ts"
    },
    "dependencies": {
        "@mantine/core": "^9.6.3",
        "keel": "workspace:*",
        "kysely": "^0.29.6",
        "next": "^16.3.8",
        "next-intl": "^4.14.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@vitejs/plugin-react": "^6.1.1",
        "vite": "^8.3.1",
        "vite-plugin-singlefile": "^2.3.3"
    }
}
