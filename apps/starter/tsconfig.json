{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@app-config/*": ["./src/app-config/*"],
            "keel/*": ["../../packages/keel/src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        ".next/types/**/*.ts",
        "*.ts",
        "config/**/*.ts",
        ".next/dev/types/**/*.ts",
        "../../packages/keel/src/**/*.ts",
        "../../packages/keel/src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "../../packages/keel/src/**/*.test.ts",
        "../../packages/keel/src/**/*.test.tsx",
        "../../packages/keel/src/**/*.stories.tsx"
    ]
}
