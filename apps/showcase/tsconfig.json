{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@app-config/*": ["./src/app-config/*"],
            "keel/*": ["../../packages/keel/src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        ".ladle/**/*.ts",
        ".ladle/**/*.tsx",
        ".next/types/**/*.ts",
        "*.ts",
        "*.mjs",
        "config/**/*.ts",
        "scripts/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
